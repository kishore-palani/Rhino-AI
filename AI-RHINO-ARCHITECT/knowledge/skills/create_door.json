{
  "schema_version": "0.1.0",
  "skill_id": "create_door",
  "name": "Create Door",
  "description": "Cut a rectangular door opening through an existing wall and place a door frame and leaf.",
  "skill_type": "create",
  "category": "architecture",
  "inputs": ["wall_guid", "position", "width", "height", "sill_height"],
  "outputs": ["door_guid", "opening_guid", "frame_guid"],
  "parameters": {
    "wall_guid": {
      "type": "guid",
      "required": true,
      "description": "GUID of the host wall object to cut and attach the door to.",
      "geometry_role": "host_wall"
    },
    "position": {
      "type": "number",
      "required": true,
      "description": "Distance along the wall baseline from the wall start to the door center.",
      "minimum": 0,
      "units": "model_units"
    },
    "width": {
      "type": "number",
      "required": true,
      "description": "Clear opening width of the door.",
      "minimum": 0,
      "units": "model_units"
    },
    "height": {
      "type": "number",
      "required": true,
      "description": "Clear opening height of the door.",
      "minimum": 0,
      "units": "model_units"
    },
    "sill_height": {
      "type": "number",
      "required": false,
      "description": "Height of the opening sill above the floor.",
      "default": 0,
      "minimum": 0,
      "units": "model_units"
    }
  },
  "preconditions": [
    "document_connected",
    "valid_guid",
    "wall_exists",
    "opening_fits_wall",
    "positive_width",
    "positive_height",
    "scope_allowed"
  ],
  "operations": [
    "resolve_units",
    "create_opening_profile",
    "boolean_difference",
    "create_door_frame",
    "create_door_leaf",
    "add_brep_to_document"
  ],
  "validation": [
    "valid_brep",
    "expected_object_count",
    "required_relationships",
    "document_state_consistent"
  ],
  "failure_modes": [
    "missing_input",
    "invalid_parameter",
    "unit_mismatch",
    "precondition_failed",
    "permission_denied",
    "tool_unavailable",
    "execution_failed",
    "invalid_guid",
    "boolean_failed",
    "invalid_brep",
    "dimension_mismatch",
    "rollback_failed"
  ],
  "metadata": {
    "version": "0.1.0",
    "status": "experimental",
    "author": "AI RHINO ARCHITECT",
    "risk_level": "high",
    "side_effects": [
      "modify host wall Brep with opening",
      "add door frame Brep to Rhino document",
      "add door leaf Brep to Rhino document"
    ],
    "rhino_tools": ["boolean_difference", "create_object", "analyze_objects"],
    "grasshopper_tools": [],
    "tags": ["architecture", "door", "opening", "boolean", "hosted"],
    "references": ["docs/architecture.md", "docs/rhino_integration.md"],
    "created_at": "2026-09-25T10:22:35Z",
    "updated_at": "2026-09-25T10:22:35Z"
  }
}