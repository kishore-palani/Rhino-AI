{
  "schema_version": "0.1.0",
  "skill_id": "create_roof",
  "name": "Create Roof",
  "description": "Create a gabled roof solid from a boundary curve, ridge height, and slope angle.",
  "skill_type": "create",
  "category": "architecture",
  "inputs": ["boundary", "ridge_height", "slope"],
  "outputs": ["roof_brep", "roof_guid"],
  "parameters": {
    "boundary": {
      "type": "curve",
      "required": true,
      "description": "Closed planar curve defining the building perimeter at eave level.",
      "geometry_role": "boundary"
    },
    "ridge_height": {
      "type": "number",
      "required": true,
      "description": "Vertical height of the roof ridge above the boundary plane.",
      "minimum": 0,
      "units": "model_units"
    },
    "slope": {
      "type": "number",
      "required": true,
      "description": "Roof pitch expressed as rise over run.",
      "minimum": 0,
      "units": "model_units"
    }
  },
  "preconditions": [
    "document_connected",
    "valid_curve",
    "closed_boundary",
    "positive_ridge_height",
    "positive_slope",
    "scope_allowed"
  ],
  "operations": [
    "resolve_units",
    "create_ridge_line",
    "create_gable_surfaces",
    "join_surfaces",
    "cap_brep",
    "add_brep_to_document"
  ],
  "validation": [
    "valid_brep",
    "closed_solid",
    "manifold",
    "correct_dimensions",
    "expected_object_count",
    "document_state_consistent"
  ],
  "failure_modes": [
    "missing_input",
    "invalid_parameter",
    "unit_mismatch",
    "precondition_failed",
    "permission_denied",
    "tool_unavailable",
    "execution_failed",
    "invalid_curve",
    "open_boundary",
    "extrusion_failed",
    "cap_failed",
    "invalid_brep",
    "open_solid",
    "dimension_mismatch",
    "rollback_failed"
  ],
  "metadata": {
    "version": "0.1.0",
    "status": "experimental",
    "author": "AI RHINO ARCHITECT",
    "risk_level": "medium",
    "side_effects": ["add roof Brep to Rhino document"],
    "rhino_tools": ["create_object", "extrude_curve", "analyze_objects"],
    "grasshopper_tools": [],
    "tags": ["architecture", "roof", "gable", "solid", "pitch"],
    "references": ["docs/architecture.md", "docs/rhino_integration.md"],
    "created_at": "2026-09-25T10:22:35Z",
    "updated_at": "2026-09-25T10:22:35Z"
  }
}