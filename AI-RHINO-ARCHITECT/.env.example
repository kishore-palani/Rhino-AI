# AI RHINO ARCHITECT - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose one: openai, anthropic, google, local
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google
GOOGLE_API_KEY=your_google_api_key_here

# Local/Open Source (Ollama, vLLM, etc.)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1

# ===========================================
# Model Configuration
# ===========================================
# Reasoning model (for planning, reasoning)
REASONING_MODEL=gpt-4o
REASONING_TEMPERATURE=0.2
REASONING_MAX_TOKENS=8192

# Vision model (for image understanding)
VISION_MODEL=gpt-4o
VISION_TEMPERATURE=0.1
VISION_MAX_TOKENS=4096

# Video model (for video understanding)
VIDEO_MODEL=gpt-4o
VIDEO_TEMPERATURE=0.1
VIDEO_MAX_TOKENS=8192

# Embedding model (for RAG)
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ===========================================
# Rhino Configuration
# ===========================================
# Rhino MCP Server
RHINO_MCP_HOST=localhost
RHINO_MCP_PORT=8765
RHINO_MCP_TIMEOUT=30
RHINO_MCP_MAX_RETRIES=3
RHINO_MCP_RETRY_BACKOFF=1.0
RHINO_MCP_USE_STDIO=false
# Defaults to the installed Rhino-MCP-Platform router under %APPDATA% when
# present; override here if it's installed elsewhere or you want the legacy
# rhinomcp PyPI package instead.
RHINO_MCP_STDIO_COMMAND=C:\Users\<you>\AppData\Roaming\McNeel\Rhinoceros\packages\8.0\Rhino-MCP-Platform\0.1.5\router\win-x64\rhino-mcp-router.exe

# Rhino Plugin
RHINO_PLUGIN_PATH=./rhino/plugin/bin/Debug/net8.0

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_rhino_architect
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# pgvector (enabled by default in PostgreSQL)
PGVECTOR_ENABLED=true

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ===========================================
# Object Storage
# ===========================================
# Local storage (development)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/objects

# S3-compatible (production)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=ai-rhino-architect
# S3_ENDPOINT_URL=https://s3.amazonaws.com

# ===========================================
# Application Configuration
# ===========================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ===========================================
# Security
# ===========================================
SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===========================================
# Feature Flags
# ===========================================
ENABLE_VIDEO_PROCESSING=false
ENABLE_GRASSHOPPER=false
ENABLE_VISION=true
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_LEARNING=false